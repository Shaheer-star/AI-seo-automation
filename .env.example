# =====================================================================
# Environment Configuration Template for Multi-Model AI Video SEO Optimizer
# Rename this file to `.env` and fill in your actual API keys before running.
# =====================================================================

# Groq API Key (Required for LLaMA-3 powered LangChain SEO agents)
# Obtain from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face API Token (Required for FLUX.1 HD Thumbnail Generation Studio)
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# YouTube Data API Key (Optional but recommended for fetching public video metadata)
# Obtain from: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Optional: Custom Hugging Face Image Generation Model (Default: black-forest-labs/FLUX.1-schnell)
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
